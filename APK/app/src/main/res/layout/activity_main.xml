<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title="NPU ENGINE"
        app:titleTextColor="@color/text_primary"
        app:elevation="0dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp">

            <!-- Model Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/modelFamilyTabs"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="10dp"
                android:background="@color/surface_card"
                app:tabIndicatorColor="@color/primary_light"
                app:tabIndicatorHeight="2dp"
                app:tabSelectedTextColor="@color/text_primary"
                app:tabTextColor="@color/text_secondary"
                app:tabMode="fixed" />

            <!-- CARD 1: Prompt & LoRA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ПРОМПТ"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/primary_light"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ModernTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/prompt_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/promptInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:maxLines="5"
                            android:textColor="@color/text_primary"
                            android:text="1girl, anime, cherry blossoms, masterpiece, best quality" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ModernTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/neg_prompt_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/negPromptInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="3"
                            android:textColor="@color/text_primary"
                            android:text="lowres, bad anatomy, bad hands, text, error, worst quality, low quality, blurry" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Seed Row with RND Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/ModernTextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/seed_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/seedInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/randomSeedButton"
                            android:layout_width="60dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:text="RND"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:padding="0dp"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@color/surface_card_secondary"
                            app:strokeColor="@color/border_card"
                            app:strokeWidth="1dp"
                            android:textColor="@color/primary_light" />
                    </LinearLayout>

                    <!-- LoRA Section -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_card"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LORA АДАПТЕР"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/primary_light"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/surface_input"
                        android:padding="2dp">

                        <Spinner
                            android:id="@+id/loraSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="44dp" />
                    </LinearLayout>

                    <!-- LoRA Scale Slider -->
                    <LinearLayout
                        android:id="@+id/loraScaleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/loraScaleLabel"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Вес LoRA: 1.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                        <SeekBar
                            android:id="@+id/loraScaleSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:min="0"
                            android:max="30"
                            android:progress="20"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/primary_light" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: Sampling & Parameters -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ПАРАМЕТРЫ СЭМПЛИРОВАНИЯ"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/primary_light"
                        android:layout_marginBottom="10dp" />

                    <!-- Steps Slider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/stepsLabel"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="Steps: 8"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                        <SeekBar
                            android:id="@+id/stepsSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:min="1"
                            android:max="50"
                            android:progress="8"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/primary_light" />
                    </LinearLayout>

                    <!-- CFG Slider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/cfgLabel"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="CFG: 3.5"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                        <SeekBar
                            android:id="@+id/cfgSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:min="10"
                            android:max="70"
                            android:progress="35"
                            android:progressTint="@color/primary_light"
                            android:thumbTint="@color/primary_light" />
                    </LinearLayout>

                    <!-- Wan 2.1 Settings -->
                    <LinearLayout
                        android:id="@+id/wanSettingsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/framesLabel"
                                android:layout_width="90dp"
                                android:layout_height="wrap_content"
                                android:text="Frames: 81"
                                android:textColor="@color/text_primary" />

                            <SeekBar
                                android:id="@+id/framesSeekBar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:min="1"
                                android:max="129"
                                android:progress="81"
                                android:progressTint="@color/primary_light"
                                android:thumbTint="@color/primary_light" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/fpsLabel"
                                android:layout_width="90dp"
                                android:layout_height="wrap_content"
                                android:text="FPS: 16"
                                android:textColor="@color/text_primary" />

                            <SeekBar
                                android:id="@+id/fpsSeekBar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:min="8"
                                android:max="30"
                                android:progress="16"
                                android:progressTint="@color/primary_light"
                                android:thumbTint="@color/primary_light" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_card"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Progressive CFG Toggle (CHECKED BY DEFAULT) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <CheckBox
                            android:id="@+id/progressiveCfg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/progressive_cfg"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/primary_light"
                            android:checked="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/progressive_cfg_desc"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="32dp"
                            android:layout_marginBottom="6dp" />
                    </LinearLayout>

                    <!-- Other toggles row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/contrastStretch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/contrast_stretch"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/primary_light"
                            android:checked="true" />

                        <CheckBox
                            android:id="@+id/livePreview"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_preview"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:buttonTint="@color/primary_light"
                            android:checked="false" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 3: Resolution & Format -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ФОРМАТ И РАЗРЕШЕНИЕ"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/primary_light"
                        android:layout_marginBottom="8dp" />

                    <!-- Quick Aspect Ratio Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip1024"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="1:1 (1024×1024)"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip832x1216"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="2:3 (832×1216)"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip1216x832"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="3:2 (1216×832)"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip768x1024"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="3:4 (768×1024)"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip1344x1728"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="HD (1344×1728)"
                                android:textSize="11sp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Custom Inputs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/ModernTextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Ширина (W)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/widthInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="1024"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" × "
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:paddingHorizontal="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/ModernTextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Высота (H)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/heightInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="1024"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Hidden spinner kept for backward compat -->
                    <Spinner
                        android:id="@+id/sizePresetSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACTION SECTION: Generate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/generateButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/generate"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#FFFFFF"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/primary"
                app:elevation="2dp" />

            <!-- Secondary Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preloadButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PRELOAD"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    app:strokeColor="@color/border_card"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unloadButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UNLOAD"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    app:strokeColor="@color/border_card"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stop"
                    android:textSize="12sp"
                    android:textColor="@color/status_red"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- STATUS & PROGRESS -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:max="100"
                android:progressTint="@color/primary_light"
                android:progressBackgroundTint="@color/badge_bg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_idle"
                android:textAlignment="center"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary" />

            <!-- CARD 4: Image Result & Actions -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/image_desc" />

                    <!-- Save Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/save"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/surface_card_secondary"
                        app:strokeColor="@color/border_card"
                        app:strokeWidth="1dp"
                        android:textColor="@color/text_primary"
                        android:visibility="gone" />

                    <!-- Timing info -->
                    <TextView
                        android:id="@+id/timingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:padding="10dp"
                        android:background="@color/badge_bg"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/badge_text"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyErrorButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/copy_error"
                        android:textSize="12sp"
                        android:textColor="@color/status_red"
                        app:strokeColor="@color/status_red"
                        app:cornerRadius="8dp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
